// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model A {
  id            String         @id @default(uuid())
  title         String
  slug          String?        @unique
  desc          String
  category      String
  price         Float
  image         String?
  dynamicModels DynamicModel[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DynamicField {
  id             String       @id @default(uuid())
  label          String
  key            String
  type           String // text, number, select, boolean, model
  options        Json?
  required       Boolean      @default(false)
  dynamicModelId String
  dynamicModel   DynamicModel @relation(fields: [dynamicModelId], references: [id])

  // 指向另一個模型
  refModelId String?
  refModel   DynamicModel? @relation("ModelReference", fields: [refModelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dynamicModelId, key])
}

model DynamicModel {
  id   String @id @default(uuid())
  name String
  aId  String
  a    A      @relation(fields: [aId], references: [id])

  fields   DynamicField[]
  dataRows DynamicData[]

  // 必須加這行！反向關係
  referencedBy DynamicField[] @relation("ModelReference")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([aId, name])
}

model DynamicData {
  id             String       @id @default(uuid())
  dynamicModelId String
  dynamicModel   DynamicModel @relation(fields: [dynamicModelId], references: [id])
  data           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
