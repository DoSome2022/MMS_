// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model A {
  id            String         @id @default(uuid())
  title         String
  slug          String?        @unique
  desc          String
  category      String
  price         Float
  image         String?
  dynamicModels DynamicModel[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DynamicModel {
  id        String   @id @default(cuid())
  name      String
  aId       String
  a         A        @relation(fields: [aId], references: [id])

  fields    DynamicField[]
  dataRows  DynamicData[]  // 這一層的資料

  // 加上這兩行
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model DynamicField {
  id              String   @id @default(cuid())
  dynamicModelId  String
  dynamicModel    DynamicModel @relation(fields: [dynamicModelId], references: [id])

  label  String
  key    String
  type   String
  options Json?
  required Boolean @default(false)
  // 加上這兩行
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// prisma/schema.prisma
model DynamicData {
  id              String   @id @default(cuid())
  dynamicModelId  String
  dynamicModel    DynamicModel @relation(fields: [dynamicModelId], references: [id])

  data            Json

  children        DynamicData[] @relation("DataTree")
  parent          DynamicData?  @relation("DataTree", fields: [parentId], references: [id])
  parentId        String?

  // 這一行一定要加！
  isContentBlock  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}